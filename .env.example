# ============================================================================
# Nhanh Media — mẫu biến môi trường
# Copy sang .env rồi thay TẤT CẢ giá trị bên dưới. KHÔNG dùng lại giá trị mẫu.
# ============================================================================

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# aaPanel: tạo database ở tab "Databases" → "PostgreSQL", rồi điền vào đây.
# Ứng dụng tự thêm connection_limit / pool_timeout nếu bạn không ghi rõ.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/nhanh_media?schema=public"

# Số connection tối đa mỗi tiến trình Node (mặc định 10).
# Nếu chạy nhiều instance PM2: DB_CONNECTION_LIMIT * số_instance < max_connections của Postgres.
DB_CONNECTION_LIMIT="10"
DB_POOL_TIMEOUT="20"

# ── Múi giờ nghiệp vụ ───────────────────────────────────────────────────────
# Mọi mốc "hôm nay / tháng này" trong báo cáo tính theo múi giờ này,
# không phụ thuộc giờ hệ điều hành của server.
BUSINESS_TIMEZONE="Asia/Ho_Chi_Minh"
TZ="Asia/Ho_Chi_Minh"

# ── URL công khai của site (BẮT BUỘC) ───────────────────────────────────────
# Dùng để đặt Telegram webhook. Không lấy từ header Host vì có thể bị giả mạo.
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ── Authentication ──────────────────────────────────────────────────────────
# Sinh mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="THAY_BANG_CHUOI_HEX_64_KY_TU_SINH_NGAU_NHIEN"

# ── Cron nhắc hạn (BẮT BUỘC, không có giá trị mặc định) ─────────────────────
# Gọi: curl "https://your-domain.com/api/cron/reminders?token=$CRON_SECRET"
CRON_SECRET="THAY_BANG_CHUOI_NGAU_NHIEN_DAI"

# ── Khoá mã hoá mật khẩu SMTP (BẮT BUỘC ở production) ───────────────────────
# Phải là chuỗi hex đúng 64 ký tự. Đổi khoá này sẽ làm hỏng mật khẩu SMTP đã lưu.
# Sinh mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMTP_ENCRYPTION_KEY="THAY_BANG_CHUOI_HEX_64_KY_TU_SINH_NGAU_NHIEN"

# ── Gemini (Trợ lý AI + bot Telegram) ───────────────────────────────────────
GEMINI_API_KEY=""

# ── SePay VietQR ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SEPAY_ACCOUNT_NUMBER=""
NEXT_PUBLIC_SEPAY_BANK_CODE=""
NEXT_PUBLIC_SEPAY_ACCOUNT_NAME=""
SEPAY_API_KEY=""
# Nếu đặt secret này, webhook sẽ xác thực bằng chữ ký HMAC-SHA256 thay vì API key.
SEPAY_WEBHOOK_SECRET=""

# ── Telegram Bot ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
# Bot CHỈ phục vụ chat ID này. Bỏ trống = bất kỳ ai tìm được bot đều dùng được.
TELEGRAM_ADMIN_CHAT_ID=""
# BẮT BUỘC: thiếu secret này webhook sẽ từ chối mọi request (trả 503).
TELEGRAM_WEBHOOK_SECRET="THAY_BANG_CHUOI_NGAU_NHIEN_DAI"
# Token bảo vệ /api/webhooks/telegram?action=set_webhook (mặc định dùng CRON_SECRET).
TELEGRAM_ADMIN_TOKEN=""
